{
  "general": {
    "python_executable": null,
    "verbose": true
  },
  "parallel": {
    "num_parallel_runs": 10,
    "runs_per_job": 10,
    "cpus_per_run": 20,
    "mem_per_cpu": "1500M",
    "num_envs": 16,
    "threads_per_env": 1,
    "use_srun_steps": true
  },
  "sweep": {
    "enabled": true,
    "group_prefix": "base_vector",
    "runs_per_permutation": 10,
    "stage_steps": [0, 400000, 800000]
  },
  "wandb": {
    "enabled": true,
    "project": "vt1_grid2op_senior_ppo",
    "group": "alpha_curriculum_10x",
    "run_name_prefix": "senior_student",
    "tags": ["grid2op", "PPO", "MORL", "curriculum"]
  },
  "paths": {
    "teacher_dir": "Teacher",
    "tutor_dir": "Tutor",
    "junior_dir": "JuniorStudent",
    "senior_dir": "SeniorStudent",
    "submission_dir": "submission",
    "actionspace_dir": "ActionSpace"
  },
  "stages": {
    "run_teacher1": false,
    "run_teacher2": false,
    "generate_action_space": false,
    "generate_tutor_dataset": false,
    "junior_train": false,
    "junior_convert": false,
    "senior_train": true,
    "pereference_condition": false,
    "gated_tiered_morl": true,
    "deploy_checkpoint": true,
    "do_nothing": false,
    "random_action": false,
    "run_runner": true
  },
  "morl": {
    "w_fair_rho": 1.0,
    "w_fair_curt": 1.0,
    "w_equity": 1.0,

    "w_ren": 1.0,
    "w_co2": 1.0,
    "w_risk": 1.0,
    "w_n1": 1.0,
    "w_econ": 1.0,

    "w_simplicity": 1.0,
    "w_l2rpn": 1.0,

    "tau_primary": 0.0,

    "alpha_struct": 1.0,
    "alpha_fair": 0.0,
    "alpha_sust": 0.0
},
  "curriculum": {
  "enabled": true,
  "stages": [
    {
      "step": 0,
      "weights": {
        "alpha_struct": 1.0,
        "alpha_fair": 0.0,
        "alpha_sust": 0.0
      }
    },
    {
      "step": 400000,
      "weights": {
        "alpha_struct": 0.5,
        "alpha_fair": 0.5,
        "alpha_sust": 0.0
      }
    },
    {
      "step": 800000,
      "weights": {
        "alpha_struct": 0.34,
        "alpha_fair": 0.33,
        "alpha_sust": 0.33
      }
    }
  ]
},

  "junior_student": {
    "train_args": ["Train"],
    "convert_args": ["Convert"]
  },
  "senior_student": {
    "script_args": []
  },
  "deployment": {
    "ckpt_source_dir": "SeniorStudent/ckpt/ppo_best",
    "ckpt_target_dir": "submission/ppo-ckpt",
    "wipe_target_before_copy": true
  }
}
